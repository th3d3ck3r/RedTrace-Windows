<Application
    x:Class="RedTrace.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF4F4F6" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#A616171D" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#4AFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
