<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core palette. Keep mutable brushes as resources so the existing
         appearance picker updates every control sharing the brush. -->
    <SolidColorBrush x:Key="RedTraceWindowBrush" Color="#F0030406" />
    <SolidColorBrush x:Key="RedTraceSurfaceBrush" Color="#F507080B" />
    <SolidColorBrush x:Key="RedTracePanelBrush" Color="#E60A0B0F" />
    <SolidColorBrush x:Key="RedTraceRaisedBrush" Color="#E6121318" />
    <SolidColorBrush x:Key="RedTraceHeaderBrush" Color="#F0101115" />
    <SolidColorBrush x:Key="RedTraceAccentBrush" Color="#FFC41E3A" />
    <SolidColorBrush x:Key="RedTraceDataTextBrush" Color="#FFDE3650" />
    <SolidColorBrush x:Key="RedTracePrimaryTextBrush" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="RedTraceSecondaryTextBrush" Color="#FF8B8D96" />
    <SolidColorBrush x:Key="RedTraceDisabledTextBrush" Color="#FF595B63" />
    <SolidColorBrush x:Key="RedTraceHairlineBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="RedTraceCardStrokeBrush" Color="#8AC41E3A" />
    <SolidColorBrush x:Key="RedTraceHoverBrush" Color="#442B0C13" />
    <SolidColorBrush x:Key="RedTracePressedBrush" Color="#663D101B" />
    <SolidColorBrush x:Key="RedTraceAlertBrush" Color="#FFFF4D5E" />
    <SolidColorBrush x:Key="RedTraceWarningBrush" Color="#FFD28A1E" />
    <SolidColorBrush x:Key="RedTraceMemoryBrush" Color="#FFC99724" />
    <SolidColorBrush x:Key="RedTraceGpuBrush" Color="#FFA854C7" />
    <SolidColorBrush x:Key="RedTraceNetworkBrush" Color="#FF318FA6" />
    <SolidColorBrush x:Key="RedTraceProcessBrush" Color="#FF4E9B51" />

    <!-- WinUI theme aliases used by built-in controls. -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF8B8D96" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E6121318" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F0101115" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFC41E3A" />

    <CornerRadius x:Key="RedTraceWindowCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="RedTraceCardCornerRadius">11</CornerRadius>
    <CornerRadius x:Key="RedTraceControlCornerRadius">7</CornerRadius>
    <Thickness x:Key="RedTraceCardPadding">10,8</Thickness>
    <Thickness x:Key="RedTracePanelPadding">12,10</Thickness>
    <FontFamily x:Key="RedTraceSansFontFamily">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="RedTraceMonoFontFamily">Cascadia Mono</FontFamily>

    <Style x:Key="RedTracePanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RedTracePanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedTraceCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RedTraceCardCornerRadius}" />
    </Style>

    <Style x:Key="RedTraceMetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RedTraceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedTraceCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="{StaticResource RedTraceCardPadding}" />
    </Style>

    <Style x:Key="RedTraceTerminalTextBoxStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="FontFamily" Value="{StaticResource RedTraceMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource RedTraceDataTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource RedTracePanelPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="RedTraceIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="31" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource RedTracePrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RedTraceControlCornerRadius}" />
    </Style>

    <Style x:Key="RedTraceLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RedTraceSansFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RedTraceMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource RedTraceCardCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource RedTraceHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedTraceHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <Style x:Key="RedTraceCompactButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="29" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Background" Value="{StaticResource RedTraceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedTraceHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RedTraceControlCornerRadius}" />
        <Setter Property="Foreground" Value="{StaticResource RedTracePrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RedTraceSansFontFamily}" />
        <Setter Property="FontSize" Value="10" />
    </Style>
</ResourceDictionary>
